unitSafe[v_] := Module[{nn = Norm[N[v]]}, If[nn < 10^-12, N[v], N[v]/nn]];

orthogonalVector[d_, seed_] := Module[{v, n},
  n = Length[d];
  v = N[seed - (seed . d)/(d . d) d];
  If[Norm[v] < 10^-10,
    v = N[UnitVector[n, 1] - (UnitVector[n, 1] . d)/(d . d) d]
  ];
  If[Norm[v] < 10^-10 && n >= 2,
    v = N[UnitVector[n, 2] - (UnitVector[n, 2] . d)/(d . d) d]
  ];
  unitSafe[v]
];

makePath[falseVac_, trueVac_, pathName_String, npts_Integer:31] := Module[
  {n, d, seed1, seed2, v1, v2, amp, tlist},
  n = Length[falseVac];
  d = N[trueVac - falseVac];
  seed1 = ConstantArray[1., n];
  seed2 = N[Reverse[Range[n]]];
  v1 = orthogonalVector[d, seed1];
  v2 = orthogonalVector[d, seed2];
  amp = 0.20 Norm[d];
  tlist = N@Subdivide[0, 1, npts - 1];

  Switch[pathName,
    "straight",
      Table[(1 - t) falseVac + t trueVac, {t, tlist}],

    "sine1small",
      Table[(1 - t) falseVac + t trueVac + 0.10 Norm[d] Sin[Pi t] v1, {t, tlist}],

    "sine1",
      Table[(1 - t) falseVac + t trueVac + amp Sin[Pi t] v1, {t, tlist}],

    "sine2",
      Table[(1 - t) falseVac + t trueVac + amp Sin[Pi t] v1 + 0.08 Norm[d] Sin[2 Pi t] v2, {t, tlist}],

    _,
      Table[(1 - t) falseVac + t trueVac, {t, tlist}]
  ]
];

(* Clean a user/imported path before passing to FindBounce. This was essential:
   even tiny endpoint mismatch/noise can make FindBounce fail. *)
cleanPath[path_, falseVac_, trueVac_] := Module[{p},
  p = Chop[N[path], 10^-12];
  p[[1]] = falseVac;
  p[[-1]] = trueVac;
  p
];

(* Load Fourier CSV for this n, orient it correctly, and force exact endpoints. *)
loadCsvFourierPath[n_Integer, falseVac_, trueVac_] := Module[{csvDir, csvFile, path},
  csvDir = FileNameJoin[{Directory[], "csv_data"}];
  csvFile = FileNameJoin[{csvDir, "fourier_path_n" <> ToString[n] <> ".csv"}];

  If[! FileExistsQ[csvFile],
    Print["Missing CSV file: ", csvFile];
    Return[$Failed]
  ];

  path = N@Import[csvFile, "CSV"];

  If[! MatrixQ[path, NumericQ], Return[$Failed]];
  If[Dimensions[path][[2]] =!= Length[falseVac], Return[$Failed]];

  If[Norm[path[[1]] - falseVac] > Norm[path[[-1]] - falseVac],
    path = Reverse[path]
  ];

  cleanPath[path, falseVac, trueVac]
];

safeAction[bf_] := Quiet@Check[N[bf["Action"]], Missing["ActionFailed"]];

runFindBounceMethod[case_Association, method_String, npts_Integer:31] := Module[
  {n, vars, V, grad, falseVac, trueVac, path, mid, time, bf, action,
   status, msg, opts, result, csvPath, straightPath, alpha, kInject, kIndices},

  n = case["nphi"];
  vars = case["vars"];
  V = case["V"];
  grad = case["grad"];
  falseVac = case["falseVac"];
  trueVac = case["trueVac"];

  Print["  method = ", method];

  result = TimeConstrained[
    AbsoluteTiming[
      Quiet@Check[
        If[n == 1,
          FindBounce[
            V,
            vars[[1]],
            {falseVac[[1]], trueVac[[1]]},
            "Gradient" -> grad[[1]],
            Dimension -> 4
          ],

          opts = {
            "Gradient" -> grad,
            "MaxPathIterations" -> 10,
            "MaxRadiusIterations" -> 200,
            "PathTolerance" -> 0.01,
            Dimension -> 4
          };

          Switch[method,
            "default",
              FindBounce[V, vars, {falseVac, trueVac}, Sequence @@ opts],

            "midpoint",
              mid = 0.5 (falseVac + trueVac);
              FindBounce[V, vars, {falseVac, trueVac}, "MidFieldPoint" -> mid, Sequence @@ opts],

            "straight",
              path = makePath[falseVac, trueVac, "straight", npts];
              FindBounce[V, vars, {falseVac, trueVac}, "FieldPoints" -> path, Sequence @@ opts],

            "sine1small" | "sine1" | "sine2",
              path = makePath[falseVac, trueVac, method, npts];
              FindBounce[V, vars, {falseVac, trueVac}, "FieldPoints" -> path, Sequence @@ opts],

            "csvFourier",
              csvPath = loadCsvFourierPath[n, falseVac, trueVac];
              If[csvPath === $Failed,
                $Failed,
                FindBounce[V, vars, {falseVac, trueVac}, "FieldPoints" -> csvPath, Sequence @@ opts]
              ],

            "csvBlend001",
              csvPath = loadCsvFourierPath[n, falseVac, trueVac];
              If[csvPath === $Failed,
                $Failed,
                straightPath = makePath[falseVac, trueVac, "straight", npts];
                alpha = 0.001;
                path = cleanPath[(1 - alpha) straightPath + alpha csvPath, falseVac, trueVac];
                FindBounce[V, vars, {falseVac, trueVac}, "FieldPoints" -> path, Sequence @@ opts]
              ],

            "csvBlend01",
              csvPath = loadCsvFourierPath[n, falseVac, trueVac];
              If[csvPath === $Failed,
                $Failed,
                straightPath = makePath[falseVac, trueVac, "straight", npts];
                alpha = 0.01;
                path = cleanPath[(1 - alpha) straightPath + alpha csvPath, falseVac, trueVac];
                FindBounce[V, vars, {falseVac, trueVac}, "FieldPoints" -> path, Sequence @@ opts]
              ],

            "csvMidpoint",
              csvPath = loadCsvFourierPath[n, falseVac, trueVac];
              If[csvPath === $Failed,
                $Failed,
                mid = csvPath[[Round[Length[csvPath]/2]]];
                FindBounce[V, vars, {falseVac, trueVac}, "MidFieldPoint" -> mid, Sequence @@ opts]
              ],

            _ /; StringMatchQ[method, "csvK" ~~ DigitCharacter ..],
              csvPath = loadCsvFourierPath[n, falseVac, trueVac];
              If[csvPath === $Failed,
                $Failed,
                kInject = ToExpression[StringDrop[method, 4]];
                kIndices = Round[1 + (Length[csvPath] - 1) Range[kInject]/(kInject + 1)];
                path = cleanPath[Join[{falseVac}, csvPath[[kIndices]], {trueVac}], falseVac, trueVac];
                FindBounce[V, vars, {falseVac, trueVac}, "FieldPoints" -> path, Sequence @@ opts]
              ],

            _,
              $Failed
          ]
        ],
        $Failed
      ]
    ],
    timeLimitSeconds,
    "TIMEOUT"
  ];

  If[result === "TIMEOUT",
    status = "timeout";
    time = timeLimitSeconds;
    action = Missing["Timeout"];
    msg = "TimeConstrained timeout";,

    time = result[[1]];
    bf = result[[2]];

    If[bf === $Failed,
      status = "failed";
      action = Missing["Failed"];
      msg = "FindBounce returned $Failed";,

      action = safeAction[bf];
      If[Head[action] === Missing,
        status = "action_failed";
        msg = "Bounce object returned but action extraction failed";,
        status = "ok";
        msg = ""
      ];
    ];
  ];

  Print["    status = ", status, "   action = ", action, "   time = ", NumberForm[time, {8, 4}], " s"];

  <|
    "nphi" -> n,
    "method" -> method,
    "status" -> status,
    "ActionFindBounceD4" -> action,
    "TimeSeconds" -> time,
    "Vfalse" -> case["Vfalse"],
    "Vtrue" -> case["Vtrue"],
    "DeltaV" -> case["DeltaV"],
    "falseVac" -> ToString[falseVac, InputForm],
    "trueVac" -> ToString[trueVac, InputForm],
    "message" -> msg
  |>
];

runCase[n_Integer, methods_List:methodsToRun, npts_Integer:nPoints] := Module[{case},
  Print["\n============================================"];
  Print["Running FindBounce nphi = ", n];

  case = makeCase[n];

  If[! AssociationQ[case],
    Print["ERROR: makeCase did not return an Association for n = ", n];
    Return[Table[
      <|"nphi" -> n, "method" -> m, "status" -> "makeCase_not_evaluated",
        "ActionFindBounceD4" -> Missing["Failed"], "TimeSeconds" -> Missing["Failed"],
        "Vfalse" -> Missing["Failed"], "Vtrue" -> Missing["Failed"],
        "DeltaV" -> Missing["Failed"], "falseVac" -> Missing["Failed"],
        "trueVac" -> Missing["Failed"], "message" -> "makeCase[n] did not evaluate"|>,
      {m, methods}]
    ];
  ];

  If[TrueQ[case["failed"]],
    Print["Preprocess failed: ", case["message"]];
    Return[Table[
      <|"nphi" -> n, "method" -> m, "status" -> "preprocess_failed",
        "ActionFindBounceD4" -> Missing["Failed"], "TimeSeconds" -> Missing["Failed"],
        "Vfalse" -> Missing["Failed"], "Vtrue" -> Missing["Failed"],
        "DeltaV" -> Missing["Failed"], "falseVac" -> Missing["Failed"],
        "trueVac" -> Missing["Failed"], "message" -> case["message"]|>,
      {m, methods}]
    ];
  ];

  Print["Vfalse = ", case["Vfalse"]];
  Print["Vtrue  = ", case["Vtrue"]];
  Print["DeltaV = ", case["DeltaV"]];

  runFindBounceMethod[case, #, npts] & /@ methods
];

runAll[nList_List, methods_List:methodsToRun, npts_Integer:nPoints] := Flatten[runCase[#, methods, npts] & /@ nList];

formatValue[x_] := Which[
  Head[x] === Missing, ToString[x, InputForm],
  NumericQ[x], N[x],
  True, ToString[x, InputForm]
];

exportResults[results_, filename_String:OUTFILE] := Module[{keys, rows},
  keys = Keys[First[results]];
  rows = Prepend[(formatValue /@ Values[#]) & /@ results, keys];
  Export[filename, rows, "CSV"];
  Print["\nSaved results to: ", filename];
  filename
];


makeSummary[res_List] := Module[{methods, rows, okRows, tvals, avals},
  methods = DeleteDuplicates[res[[All, "method"]]];
  rows = Table[
    okRows = Select[res, # ["method"] == m && # ["status"] == "ok" &];
    tvals = Select[okRows[[All, "TimeSeconds"]], NumberQ];
    avals = Select[okRows[[All, "ActionFindBounceD4"]], NumberQ];
    <|
      "method" -> m,
      "successCount" -> Length[okRows],
      "totalRuns" -> Count[res[[All, "method"]], m],
      "medianTime" -> If[Length[tvals] > 0, Median[tvals], Missing["NoSuccess"]],
      "minTime" -> If[Length[tvals] > 0, Min[tvals], Missing["NoSuccess"]],
      "medianAction" -> If[Length[avals] > 0, Median[avals], Missing["NoSuccess"]],
      "minAction" -> If[Length[avals] > 0, Min[avals], Missing["NoSuccess"]]
    |>,
    {m, methods}
  ];
  rows
];

exportSummary[summary_, filename_] := Module[{keys, rows},
  keys = Keys[First[summary]];
  rows = Prepend[Values /@ summary, keys];
  Export[filename, rows, "CSV"]
];

Print["Current directory = ", Directory[]];
Print["Output file will be = ", OUTFILE];
Print["Methods = ", methodsToRun];
Print["N list = ", runNList];
Print["Time limit per FindBounce call = ", timeLimitSeconds, " seconds"];

results = runAll[runNList, methodsToRun, nPoints];
exportResults[results, OUTFILE];
summary = makeSummary[results];
exportSummary[summary, SUMMARYFILE];

Print["\n================ SUMMARY TABLE ================"];
Print[Dataset[summary]];
Print["\nSaved raw results to: ", OUTFILE];
Print["Saved summary to: ", SUMMARYFILE];

Print["\nDONE. To see CSV files here, run: FileNames[\"*.csv\", Directory[]]"];
