    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"h", "^", "2"}], "-", "1"}], ")"}], "^", "2"}], ")"}], "/", 
      "4"}], "+", 
