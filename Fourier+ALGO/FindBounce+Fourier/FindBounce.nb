      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"s", "^", "2"}], "-", "1"}], ")"}], "^", "2"}], ")"}], "/", 
      "4"}], "+", 
     RowBox[{"lambda", " ", 
      RowBox[{"h", "^", "2"}], " ", 
      RowBox[{"s", "^", "2"}]}], "-", 
     RowBox[{"epsilon", " ", "h"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 

 RowBox[{
  RowBox[{
   RowBox[{"vars", "=", 
    RowBox[{"{", 
     RowBox[{"h", ",", "s"}], "}"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"phiTrue", "=", 
   RowBox[{"{", 
    RowBox[{"0.89427236", ",", "0.72122546"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"phiFalse", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "0.60590553"}], ",", "0.88302157"}], "}"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dummyPath", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "t"}], ")"}], "*", 
          RowBox[{"phiFalse", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "+", 
         RowBox[{"t", "*", 
          RowBox[{"phiTrue", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "+", 
         RowBox[{"0.25", "*", 
          RowBox[{"Sin", "[", 
           RowBox[{"Pi", "*", "t"}], "]"}]}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "t"}], ")"}], "*", 
          RowBox[{"phiFalse", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "+", 
         RowBox[{"t", "*", 
          RowBox[{"phiTrue", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "-", 
         RowBox[{"0.15", "*", 
          RowBox[{"Sin", "[", 
           RowBox[{"Pi", "*", "t"}], "]"}]}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "1", ",", 
        RowBox[{"1", "/", "30"}]}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bf", "=", 
    RowBox[{"FindBounce", "[", 
     RowBox[{
      RowBox[{"V", "[", 
