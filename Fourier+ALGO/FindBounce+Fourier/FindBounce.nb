     RowBox[{
      RowBox[{"-", "0.60590553"}], ",", "0.88302157"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dummyPath", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "t"}], ")"}], "*", 
          RowBox[{"phiFalse", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "+", 
         RowBox[{"t", "*", 
          RowBox[{"phiTrue", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "+", 
         RowBox[{"0.25", "*", 
