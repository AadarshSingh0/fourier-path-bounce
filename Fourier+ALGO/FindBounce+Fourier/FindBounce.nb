          RowBox[{"s", "^", "2"}], "-", "1"}], ")"}], "^", "2"}], ")"}], "/", 
      "4"}], "+", 
     RowBox[{"lambda", " ", 
      RowBox[{"h", "^", "2"}], " ", 
      RowBox[{"s", "^", "2"}]}], "-", 
     RowBox[{"epsilon", " ", "h"}]}]}], ";"}], "\[IndentingNewLine]"}], "\n", 

 RowBox[{
  RowBox[{
   RowBox[{"vars", "=", 
    RowBox[{"{", 
     RowBox[{"h", ",", "s"}], "}"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"phiTrue", "=", 
   RowBox[{"{", 
    RowBox[{"0.89427236", ",", "0.72122546"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"phiFalse", "=", 
