ClearAll[makeCase, runCase, runAll, exportResults];

makeCase[n_Integer] := Module[
  {vars, data, delta, c, Vexpr, grad, falseVac, min, trueVac, Vfalse, Vtrue, Vshift, gradShift},

  data = coeffData[n];
  delta = data["delta"];
  c = data["c"];

  (* Use real Mathematica symbols phi1, phi2, ... .
     Do NOT use Array[phi,n], because that gives phi[1], phi[2], ...
     and Clear[phi[1]] gives Clear::ssym. *)
  vars = Table[Symbol["phi" <> ToString[i]], {i, 1, n}];
  Clear @@ vars;

  Vexpr =
    (Sum[c[[i]] (vars[[i]] - 1)^2, {i, 1, n}] - delta)
    Sum[vars[[i]]^2, {i, 1, n}];

  falseVac = ConstantArray[0., n];

  min = Quiet[
    Check[
      FindMinimum[
        Vexpr,
        Evaluate[Thread[{vars, ConstantArray[1., n]}]],
        MaxIterations -> 5000
      ],
      $Failed
    ]
  ];

  If[min === $Failed,
    Return[<|"nphi" -> n, "failed" -> True, "message" -> "FindMinimum failed"|>]
  ];

  trueVac = N[vars /. min[[2]]];

  Vfalse = N[Vexpr /. Thread[vars -> falseVac]];
  Vtrue = N[Vexpr /. Thread[vars -> trueVac]];

  Vshift = Vexpr - Vfalse;
  gradShift = D[Vshift, #] & /@ vars;

  <|
    "nphi" -> n,
    "delta" -> delta,
    "c" -> c,
    "vars" -> vars,
    "V" -> Vshift,
    "grad" -> gradShift,
    "falseVac" -> falseVac,
    "trueVac" -> trueVac,
    "Vfalse" -> N[Vshift /. Thread[vars -> falseVac]],
    "Vtrue" -> N[Vshift /. Thread[vars -> trueVac]],
    "DeltaV" -> N[Vfalse - Vtrue],
    "failed" -> False
  |>
];

runCase[n_Integer] := Module[
  {case, time, bf, action, status, msg, vars, V, grad, falseVac, trueVac, mid},

  Print["\n============================================"];
  Print["Running FindBounce nphi = ", n];

  case = makeCase[n];

  If[TrueQ[case["failed"]],
    Return[
      <|
        "nphi" -> n,
        "status" -> "preprocess_failed",
        "ActionFindBounceD4" -> Missing["Failed"],
        "TimeSeconds" -> Missing["Failed"],
        "Vfalse" -> Missing["Failed"],
        "Vtrue" -> Missing["Failed"],
        "DeltaV" -> Missing["Failed"],
        "message" -> case["message"]
      |>
    ]
  ];

  vars = case["vars"];
  V = case["V"];
  grad = case["grad"];
  falseVac = case["falseVac"];
  trueVac = case["trueVac"];
  mid = 0.5 (falseVac + trueVac);

  Print["Vfalse = ", case["Vfalse"]];
  Print["Vtrue  = ", case["Vtrue"]];
  Print["DeltaV = ", case["DeltaV"]];

  {time, bf} = AbsoluteTiming[
    Quiet[
      Check[
        If[n == 1,
          FindBounce[
            V,
            vars[[1]],
            {falseVac[[1]], trueVac[[1]]},
            "Gradient" -> grad[[1]],
            Dimension -> 4
          ],
          FindBounce[
            V,
            vars,
            {falseVac, trueVac},
            "Gradient" -> grad,
            "MidFieldPoint" -> mid,
            "FieldPoints" -> 31,
            "MaxPathIterations" -> 5,
            "MaxRadiusIterations" -> 150,
            "PathTolerance" -> 0.01,
            Dimension -> 4
          ]
        ],
        $Failed
      ]
    ]
  ];

  If[bf === $Failed,
    status = "failed";
    action = Missing["Failed"];
    msg = "FindBounce returned $Failed";,
    status = "ok";
    action = Quiet[Check[N[bf["Action"]], Missing["ActionFailed"]]];
    msg = "";
  ];

  Print["status = ", status];
  Print["action = ", action];
  Print["time   = ", time];

  <|
    "nphi" -> n,
    "status" -> status,
    "ActionFindBounceD4" -> action,
    "TimeSeconds" -> time,
    "Vfalse" -> case["Vfalse"],
    "Vtrue" -> case["Vtrue"],
    "DeltaV" -> case["DeltaV"],
    "falseVac" -> ToString[case["falseVac"], InputForm],
    "trueVac" -> ToString[case["trueVac"], InputForm],
    "message" -> msg
  |>
];

runAll[nList_List] := runCase /@ nList;

exportResults[results_, filename_String:"mega_random_findbounce_results.csv"] := Module[
  {rows},
  rows = Normal /@ results;
  Export[filename, rows, "CSV"]
];

