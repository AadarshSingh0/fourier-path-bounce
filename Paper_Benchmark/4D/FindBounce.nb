Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Set", " ", "current", " ", "directory", " ", "to", " ", "this", " ", 
    RowBox[{"notebook", "'"}], "s", " ", "folder"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SetDirectory", "[", 
    RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Current directory = \>\"", ",", 
     RowBox[{"Directory", "[", "]"}]}], "]"}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Load", " ", "FindBounce", " ", "package"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Needs", "[", "\"\<FindBounce`\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Load", " ", "your", " ", "existing", " ", "runner", " ", "file"}],
    "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Get", "[", "\"\<mega_random_findbounce_runner_FIXED.wl\>\"", "]"}], ";"}],
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Run", " ", "selected", " ", "cases"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"results", "=", 
    RowBox[{"runAll", "[", 
     RowBox[{"Range", "[", 
      RowBox[{"1", ",", "50"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Save", " ", "output"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"exportResults", "[", 
    RowBox[{"results", ",", "\"\<mega_random_findbounce_results.csv\>\""}], 
    "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
